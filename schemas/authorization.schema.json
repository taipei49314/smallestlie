{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smallestlie.local/schemas/authorization.schema.json",
  "title": "SmallestLie Authorization",
  "type": "object",
  "required": ["mode", "owner", "target_path", "allowed_attack_families"],
  "properties": {
    "schema_version": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["owned_local_repo", "synthetic_fixture", "explicit_allowlist", "disposable_clone"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "target_path": { "type": "string", "minLength": 1 },
    "disposable_clone_required": { "type": "boolean" },
    "network": { "type": "string", "const": "denied" },
    "expires_at": { "type": ["string", "null"] },
    "allowed_attack_families": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "allowlisted_roots": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
